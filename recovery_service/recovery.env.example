# Keep the real file on your service host, mode 600. Never bundle it in the APK.
RECOVERY_MASTER_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
RECOVERY_DATABASE=/var/lib/radio-recovery/recovery.sqlite3
RECOVERY_BIND=127.0.0.1
RECOVERY_PORT=8787
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM='Radio Workbook <radio@example.org>'
